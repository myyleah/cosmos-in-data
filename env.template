# Cosmos in Data — NASA APOD Pipeline
# ======================================
# Rename this file to .env and fill in your credentials.
# IMPORTANT: never commit .env to GitHub. It is listed in .gitignore.

# ── Supabase PostgreSQL ────────────────────────────────────────────────────────
# Find these in: Supabase dashboard → Project Settings → Database → Connection string
SUPABASE_DB_URL=postgresql+psycopg2://postgres.YOUR_PROJECT_REF:YOUR_PASSWORD@aws-0-YOUR_REGION.pooler.supabase.com:5432/postgres

# Alternative: provide ref and password separately instead of the full URL above
# DB_PASSWORD=your_supabase_database_password
# DB_REF=your_supabase_project_ref

# ── NASA API ───────────────────────────────────────────────────────────────────
# Register for a free key at: https://api.nasa.gov
# Without a key, DEMO_KEY works but is rate-limited to 30 requests/hour
NASA_API_KEY=your_nasa_api_key_here

# ── Pipeline options ───────────────────────────────────────────────────────────
# Set to true to drop and recreate all tables (full reload). Default: false (incremental)
RESET_TABLES=false

# Date range to extract. Defaults: 2020-01-01 to today
# START_DATE=2020-01-01
# END_DATE=2025-12-31
